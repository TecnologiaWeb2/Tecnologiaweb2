# Credenciales reales de la base de datos: nunca al repositorio (se usa config/config.ejemplo.php como plantilla)
config/config.php

# Datos locales: el repositorio solo lleva los datos de demostración (productos.inicial.json)
datos/productos.json
datos/fotos/*
!datos/fotos/.gitkeep
datos/*.tmp

# Archivos temporales de Office y del sistema
~$*
.DS_Store
Thumbs.db
.vscode/

# Configuración local del editor
*.code-workspace

# Paquete para InfinityFree (lleva config.php con la clave del hosting y CREDENCIALES.txt): se genera, no se sube
dist/

# Fotos originales sin procesar (las de demostración están en bd/fotos-demo)
fotosdeaprendas/

# Dependencias de los laboratorios (se instalan con composer / npm)
laboratorios/*/vendor/
laboratorios/*/node_modules/
laboratorios/*/ejemplos/tokens.txt
.env
